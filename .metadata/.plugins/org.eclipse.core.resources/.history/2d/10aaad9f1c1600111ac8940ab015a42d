spring.application.name=backend

spring.datasource.driver-class-name=org.mariadb.jdbc.Driver
#spring.datasource.url=jdbc:mariadb://localhost:3306/malldb?localSocketAddress=localhost&disableSslHostnameVerification=true
# 127.0.0.1을 사용하고 인증 관련 파라미터를 추가합니다.
spring.datasource.url=jdbc:mariadb://127.0.0.1:3306/malldb?localSocketAddress=localhost&allowPublicKeyRetrieval=true&useSSL=false&disableSslHostnameVerification=true
spring.datasource.username=malldbuser
spring.datasource.password=malldbuser

spring.jpa.hibernate.ddl-auto=create
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MariaDBDialect

spring.servlet.multipart.max-request-size=30MB
spring.servlet.multipart.max-file-size=10MB

#com.example.upload.path=update

logging.level.org.springframework.security.web=trace





